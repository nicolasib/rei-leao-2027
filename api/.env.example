# Postgres. Em dev: qualquer Postgres local (o valor abaixo é o do gate, ver
# smoke/PROJECT.md). Em produção: injetado pela Vercel ao provisionar o
# Postgres na aba Storage.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55433/postgres

# Em produção, na Vercel, defina explicitamente DB_DRIVER=neon. O chute por
# domínio cai em node-postgres quando o host não é neon.tech e degrada em
# silêncio dentro de uma function serverless.
# DB_DRIVER=neon
